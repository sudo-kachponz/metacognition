# ═══════════════════════════════════════════════════════════════════════
# BCI Speech Decoder Platform — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────
APP_NAME="BCI Speech Decoder API"
DEBUG=true

# ── CORS (comma-separated origins) ───────────────────────────────────
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# ── Decoder ──────────────────────────────────────────────────────────
DEFAULT_DECODER_MODE=supervised
MODEL_WEIGHTS_DIR=./weights
N_EEG_CHANNELS=64
EEG_SFREQ=500.0
N_CLASSES=50
DEVICE=auto

# ── LSL ──────────────────────────────────────────────────────────────
LSL_STREAM_NAME=BCI_EEG
LSL_STREAM_TYPE=EEG
LSL_BUFFER_SECONDS=2.0
LSL_USE_MOCK=true

# ── InfluxDB ─────────────────────────────────────────────────────────
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=bci-lab
INFLUXDB_BUCKET=eeg_data

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://bci:bci@localhost:5432/bci

# ── Ollama (optional) ────────────────────────────────────────────────
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
